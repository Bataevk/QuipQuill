# TLS from Let's Encrypt for $DOMAIN; HTTP is redirected to HTTPS. WebSocket (/ws) passes through.
# The cloud's own paths go to the cloud; everything else is the web version (ADR 69), a static
# build that CI puts in /opt/quipquill/web/releases/<sha> behind the `current` symlink.
{$DOMAIN} {
	# Caddy's own list misses the story file (SQLite: 1.3 MB → 0.6 MB); this one covers what the
	# cloud and the web build send.
	encode zstd gzip {
		match {
			header Content-Type text/*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/wasm*
			header Content-Type application/vnd.sqlite3*
			header Content-Type font/*
			header Content-Type image/svg+xml*
			header Content-Type image/x-icon*
		}
	}

	@cloud path /auth/* /me /me/* /ws /stories /stories/* /embeddings /waitlist /health /health/*
	handle @cloud {
		reverse_proxy cloud:8000
	}

	handle {
		root * /srv/web/current
		# Hashed bundles and assets never change; the rest (index.html, the SQLite worker) is
		# checked on every visit, so a new release reaches the next page load.
		header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		header ?Cache-Control "no-cache"
		@story path *.qqstory
		header @story Content-Type application/vnd.sqlite3

		# Build files as they are: a missing bundle, asset or worker file is a 404, not the page.
		@build path /_expo/* /assets/* /sqlite/*
		handle @build {
			file_server
		}
		# A single-page app: any other path (/story/<id>, /game/<id>) is one of its routes.
		handle {
			try_files {path} /index.html
			file_server
		}
	}
}
