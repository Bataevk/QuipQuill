# Secrets of the cloud on the server (ADR 51). The real file is the GitHub environment secret
# CLOUD_SECRET_ENV of `production` (Settings → Environments → production → Secrets): paste the
# whole file there; CI writes it to /opt/quipquill/cloud.secret.env (mode 600) on every deploy.
# Never commit the filled-in file.

# HS256 key, at least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OPENROUTER_API_KEY=
# Registration is invite-only: JSON list of valid codes.
INVITE_CODES=["change-me-invite"]
