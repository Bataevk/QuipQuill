# Secrets of the cloud on the server: /opt/quipquill/cloud.secret.env (mode 600). Each key is its
# own secret of the GitHub environment `production` (Settings → Environments → production →
# Secrets), named like the key (ADR 65): on every deploy CI replaces the line of each secret that is
# set and keeps the server's value of the others. Paste only the value, not KEY=.
# Never commit the filled-in file.

# HS256 key, at least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OPENROUTER_API_KEY=
# Registration is invite-only: JSON list of valid codes.
INVITE_CODES=["change-me-invite"]
