# Non-secret settings of the cloud on the server (ADR 51). The real file is the GitHub environment
# variable CLOUD_CONFIG_ENV of `production` (Settings → Environments → production → Variables):
# paste the whole file there; CI writes it to /opt/quipquill/cloud.config.env on every deploy.
# Secrets go to cloud.secret.env (CLOUD_SECRET_ENV), which wins on a duplicate key.
# All keys: cloud/.env.example. ENV, LOG_FORMAT, DATABASE_URL, RABBITMQ_URL and QUEUE_PREFIX are
# set by docker-compose.yml.

# Spend cap per user per UTC day, USD (the tier's own cap when not set).
DAILY_COST_LIMIT_USD=1
# LOG_LEVEL=info
# Chat model for every route at once; unset = each route's own (llm/policy.py: Haiku 5.5).
# LLM_MODEL=inception/mercury-3
# Providers for every route at once, while one is down (JSON list); unset = each route's own
# order (cloud/src/quipquill_cloud/llm/policy.py: Vertex global, then Bedrock); [] = any provider.
# PROVIDER_ORDER=["amazon-bedrock"]
# Spare model when the main one fails before its first token; empty = none
# LLM_FALLBACK_MODEL=anthropic/claude-haiku-5.5
# Its providers (JSON list): unset = the route's own (Vertex, Bedrock), [] = any
# LLM_FALLBACK_PROVIDERS=["google-vertex/global"]
# Guest accounts of the device (ADR 60): the app's onboarding signs in this way.
GUEST_SIGNUP=true
# A guest's allowance for the whole prototype, USD (ADR 66): ~30 turns. Default 0.10.
# GUEST_TOTAL_COST_LIMIT_USD=0.10
# GUEST_SIGNUP_PER_MINUTE=2
# GUEST_SIGNUP_BURST=5
# The web version from another origin (JSON list). Not needed when the web build is served by
# the cloud's own host (ADR 69); ENV=dev allows every localhost port anyway.
# CORS_ORIGINS=["https://play.example.com"]
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_BURST=10
# WORKER_CONCURRENCY=4
# LLM_TIMEOUT_SECONDS=120
