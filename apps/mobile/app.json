{
  "expo": {
    "name": "foolore",
    "slug": "quipquill",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "quipquill",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.quipquill.mobile",
      "appleTeamId": "N7M7838735"
    },
    "android": {
      "package": "app.quipquill.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#332E36",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4ECDD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1D1A1E",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/im-fell-english/400Regular/IMFellEnglish_400Regular.ttf",
            "./node_modules/@expo-google-fonts/im-fell-english/400Regular_Italic/IMFellEnglish_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/literata/400Regular/Literata_400Regular.ttf",
            "./node_modules/@expo-google-fonts/literata/400Regular_Italic/Literata_400Regular_Italic.ttf",
            "./node_modules/@expo-google-fonts/literata/600SemiBold/Literata_600SemiBold.ttf"
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
