# Copy to builder/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACT_MODEL=anthropic/claude-haiku-5.5
# SUMMARIZE_MODEL=            # defaults to EXTRACT_MODEL
EMBED_MODEL=openai/text-embedding-3-small
# REASONING_EFFORT=low        # low | medium | high; empty = provider default
# Sync chat calls go only to providers that don't log prompts (JSON list):
# PROVIDER_ONLY=["amazon-bedrock", "google-vertex/global"]
# Graph building and embeddings use the Batch API by default (-50% price, minutes to hours);
# `--sync` on extract/export switches to regular calls.
# USE_BATCH=true
# BATCH_POLL_INTERVAL=30
# BATCH_TIMEOUT=21600
# TEMPERATURE=                # leave unset for Claude 5.x (non-default values are rejected)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200
# MERGE_THRESHOLD=0.85
# MAX_CONCURRENCY=4
