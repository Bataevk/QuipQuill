# Copy to builder/.env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EXTRACT_MODEL=anthropic/claude-haiku-5.5
# SUMMARIZE_MODEL=            # defaults to EXTRACT_MODEL
EMBED_MODEL=openai/text-embedding-3-small
# REASONING_EFFORT=low        # low | medium | high; empty = provider default
# TEMPERATURE=                # leave unset for Claude 5.x (non-default values are rejected)
# CHUNK_SIZE=2000
# CHUNK_OVERLAP=200
# MERGE_THRESHOLD=0.85
# MAX_CONCURRENCY=4
