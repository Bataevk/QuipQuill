# Copy to cloud/.env and fill in. Never commit .env.
ENV=dev
# LOG_LEVEL=info
# LOG_FORMAT=text             # json in containers (docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://quipquill:quipquill@localhost:5432/quipquill
RABBITMQ_URL=amqp://quipquill:quipquill@localhost:5672/
QUEUE_PREFIX=qq.dev
# RabbitMQ down at startup: first pause before trying again (doubling to 30 s).
# MQ_RETRY_SECONDS=2
# Workers run inside the API process (ADR 18). Stage 2.2 handler: echo (streams the user text back).
# RUN_WORKERS=true
# WORKER_CONCURRENCY=4
# LLM_HANDLER=openrouter      # or echo (no model calls)
# LLM_TIMEOUT_SECONDS=120
# Abuse limits on top of the daily spend cap:
# RATE_LIMIT_PER_MINUTE=30
# RATE_LIMIT_BURST=10
# MAX_HTTP_BODY_BYTES=1000000
# MAX_REQUEST_TOKENS=95000     # chars/4 estimate of an llm.request
# MAX_TOOLS=32
# WS_HEARTBEAT_INTERVAL=2.0
# First WebSocket message must be `auth` within this many seconds (ADR 22).
# WS_AUTH_TIMEOUT=10
# GENERATION_TTL_SECONDS=900
# HS256 key, at least 32 bytes; the service refuses to start in prod with a shorter/default one.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Registration is invite-only: JSON list of valid codes; empty = registration closed.
INVITE_CODES=["change-me-invite"]
# Guest accounts of the device, no email or password (ADR 60): the app's onboarding signs in this
# way. Off by default; per client IP at most GUEST_SIGNUP_BURST in a row, then the per-minute rate.
GUEST_SIGNUP=true
# A guest's allowance for the whole prototype, USD (ADR 66): ~30 turns; unset = no such limit.
# GUEST_TOTAL_COST_LIMIT_USD=0.10
# GUEST_SIGNUP_PER_MINUTE=2
# GUEST_SIGNUP_BURST=5
# The story catalogue: every *.qqstory under this folder (ADR 61); default — the repository's stories/.
# STORIES_DIR=../stories
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Models and daily limits per tier live in code: src/quipquill_cloud/llm/policy.py
# PROVIDER_ORDER=["amazon-bedrock", "google-vertex/global"]
EMBED_MODEL=openai/text-embedding-3-small

# Spend cap per UTC day in USD for every account, instead of the tier's own ($0.05 for free).
# For local test runs and demos; leave unset in production.
# DAILY_COST_LIMIT_USD=1
