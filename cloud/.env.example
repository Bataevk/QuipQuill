# Copy to cloud/.env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=postgresql+asyncpg://quipquill:quipquill@localhost:5432/quipquill
RABBITMQ_URL=amqp://quipquill:quipquill@localhost:5672/
QUEUE_PREFIX=qq.dev
# HS256 key, at least 32 bytes; the service refuses to start in prod with a shorter/default one.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# Registration is invite-only: JSON list of valid codes; empty = registration closed.
INVITE_CODES=["change-me-invite"]
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_FREE=anthropic/claude-haiku-5.5
EMBED_MODEL=openai/text-embedding-3-small
